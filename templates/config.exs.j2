# Mobilizon instance configuration

import Config

config :mobilizon, Mobilizon.Web.Endpoint,
    server: true,
    url: [
        host: "{{ mobilizon_config_domain }}"
        scheme: "https"
    ],
    http: [
        ip: {0,0,0,0},
        port: 4000
	],
   	http_security: [
    	enabled: true
    ],
	secret_key_base: "{{ mobilizon_config_secret_key_base }}",
	has_reverse_proxy: true

config :mobilizon, Mobilizon.Web.Auth.Guardian,
	secret_key: "{{ mobilizon_config_secret_key }}"

config :mobilizon, :instance,
	name: "{{ mobilizon_config_instance_name }}",
	description: "{{ mobilizon_config_description }}",
	hostname: "{{ mobilizon_config_domain }}",
	registrations_open: false,
	demo: false,
	allow_relay: false,
	federating: false,
	email_from: "{{ mobilizon_config_domain }}",
	email_reply_to: "{{ mobilizon_config_mail_username }}"

config :mobilizon, Mobilizon.Storage.Repo,
	adapter: Ecto.Adapters.Postgres,
	username: "mobilizon",
	password: "{{ mobilizon_db_user_pw }}",
	database: "mobilizon_prod",
	hostname: "localhost",
	port: "5432",
	pool_size: 10

config :mobilizon, Mobilizon.Web.Email.Mailer,
	adapter: Swoosh.Adapters.SMTP,
	relay: "{{ mobilizon_config_mail_server }}",
	port: {{ mobilizon_config_mail_port }},
	username: "{{ mobilizon_config_mail_username }}",
	password: "{{ mobilizon_config_mail_password }}",
	tls: :always,
	tls_options: [
		verify: :verify_peer,
		versions: [:"tlsv1.2", :"tlsv1.3"],
		cacerts: :public_key.cacerts_get(),
		server_name_indication: :disable,
		depth: 99
  	],
	retries: 2,
	no_mx_lookups: false,
	auth: :always

config :mobilizon, Mobilizon.Web.Upload.Uploader.Local,
	uploads: "{{ mobilizon_dir_upload }}"

config :mobilizon, :exports,
	path: "{{ mobilizon_dir_upload }}/exports"